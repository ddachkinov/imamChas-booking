# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to git!

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
MAIN_DOMAIN=yourbrand.com
ACME_EMAIL=admin@yourbrand.com

# =============================================================================
# DATABASE
# =============================================================================
DB_NAME=booking_platform
DB_USER=postgres
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_32_CHARS

# =============================================================================
# REDIS
# =============================================================================
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_32_CHARS

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_64_CHARS
REFRESH_TOKEN_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_STRING_64_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# =============================================================================
# STRIPE PAYMENT PROCESSING
# =============================================================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLIC_KEY=pk_live_xxxxx
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Pricing (get from Stripe Dashboard after creating products)
STRIPE_STARTER_PRICE_ID=price_xxxxx
STRIPE_PROFESSIONAL_PRICE_ID=price_xxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxx

# =============================================================================
# EMAIL (SendGrid)
# =============================================================================
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=noreply@yourbrand.com
EMAIL_FROM_NAME=Your Business Name

# =============================================================================
# SMS (Twilio) - Optional
# =============================================================================
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# FILE STORAGE (AWS S3)
# =============================================================================
# Get from: https://console.aws.amazon.com/iam/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAxxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
S3_BUCKET_NAME=booking-platform-files
S3_PUBLIC_URL=https://booking-platform-files.s3.amazonaws.com

# =============================================================================
# MONITORING (Sentry) - Optional
# =============================================================================
# Get from: https://sentry.io/settings/
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
LOG_LEVEL=info

# =============================================================================
# FEATURE FLAGS
# =============================================================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# =============================================================================
# TRAEFIK DASHBOARD
# =============================================================================
# Generate with: echo $(htpasswd -nb admin your-password-here)
# Or use: https://hostingcanada.org/htpasswd-generator/
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$8sqpg8j4$$U7V7KoKBmCnPrXKu7rVqc1

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
